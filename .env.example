# Postgres
POSTGRES_DB=mastermind
POSTGRES_USER=mastermind
POSTGRES_PASSWORD=<openssl rand -base64 12>
POSTGRES_PORT=54321

# MinIO
MINIO_ROOT_USER=mastermind
MINIO_ROOT_PASSWORD=<openssl rand -base64 12>
MINIO_SERVICE_PORT=9000
MINIO_CONSOLE_PORT=9001

# Neo4j
NEO4J_DATABASE=mastermind
NEO4J_USER=neo4j
NEO4J_PASSWORD=<openssl rand -base64 12>
NEO4J_CONSOLE_PORT=7474
NEO4J_BOLT_PORT=7687

# Redis
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=<openssl rand -base64 12>
REDIS_QUEUE_INSTANCE=0
REDIS_RESULT_INSTANCE=1

# Authentik
AUTHENTIK_DB=authentik
AUTHENTIK_SECRET_KEY=<openssl rand -hex 32>
COMPOSE_PORT_HTTP=9400
COMPOSE_PORT_HTTPS=9443

# RabbitMQ
RABBIT_MQ_HOST=localhost
RABBIT_MQ_PORT=5672
RABBIT_MQ_MANAGEMENT_PORT=15672
RABBIT_MQ_VHOST=mastermind
RABBIT_MQ_USER=mastermind
RABBIT_MQ_PASSWORD=<openssl rand -base64 12>

# RabbitMQ
QDRANT_API_KEY=<openssl rand -hex 16>
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# Langfuse
LANGFUSE_DB=mastermind
LANGFUSE_SALT=<openssl rand -hex 16>
LANGFUSE_ENCRYPTION_KEY=<openssl rand -hex 32>
LANGFUSE_NEXTAUTH_SECRET=<openssl rand -hex 32>
LANGFUSE_NEXTAUTH_URL=http://localhost:4000
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_WORKER_PORT=3030
LANGFUSE_WEB_PORT=4000

# ClickHouse (langfuse analytics store)
CLICKHOUSE_DB=mastermind
CLICKHOUSE_USER=mastermind
CLICKHOUSE_PASSWORD=<openssl rand -base64 12>
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9004